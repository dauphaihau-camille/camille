#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: ./scripts/verify [target]

Targets:
  all        Run the default API, contract, and web verification checks
  api        Run NestJS API lint, typecheck, and unit tests
  spec       Verify the committed OpenAPI document and api-spec package copy
  api-types  Verify web generated API types match the committed contract
  contract   Check the OpenAPI document for breaking changes against the base branch
  web        Run web monorepo typecheck, lint, and tests
  app        Run the main web app typecheck
  marketing  Run the marketing app typecheck
  shared     Run the shared web package typecheck
  e2e        Run the main web app Playwright tests

Default target: all
USAGE
}

run_api() {
  cd "$ROOT_DIR/apps/api/api"
  pnpm check
}

run_spec() {
  cd "$ROOT_DIR/apps/api/api"
  pnpm spec:generate -- --check
  pnpm spec:package
  pnpm spec:package -- --check
}

run_api_types() {
  cd "$ROOT_DIR/apps/web"
  # Before the contract package is published (and in the superproject, where
  # both submodules are checked out), verify the committed types against the
  # API's committed spec. Once the package is installed, the check uses the
  # pinned published contract instead.
  if [ -d node_modules/@dauphaihau-camille/api-spec ]; then
    bun run generate:api-types -- --check
  else
    API_SPEC_PATH="$ROOT_DIR/apps/api/api/openapi.json" bun run generate:api-types -- --check
  fi
}

run_contract() {
  cd "$ROOT_DIR"
  node apps/api/api/scripts/check-contract-breaking.mjs
}

run_web() {
  cd "$ROOT_DIR/apps/web"
  bun run check
}

run_app() {
  cd "$ROOT_DIR/apps/web"
  bun run typecheck:app
}

run_marketing() {
  cd "$ROOT_DIR/apps/web"
  bun run typecheck:marketing
}

run_shared() {
  cd "$ROOT_DIR/apps/web"
  bun run typecheck:shared
}

run_e2e() {
  cd "$ROOT_DIR/apps/web"
  bun run test:e2e
}

target="${1:-all}"

case "$target" in
  all)
    run_api
    run_spec
    run_api_types
    run_web
    ;;
  api)
    run_api
    ;;
  spec)
    run_spec
    ;;
  api-types)
    run_api_types
    ;;
  contract)
    run_contract
    ;;
  web)
    run_web
    ;;
  app)
    run_app
    ;;
  marketing)
    run_marketing
    ;;
  shared)
    run_shared
    ;;
  e2e)
    run_e2e
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown verification target: $target" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
